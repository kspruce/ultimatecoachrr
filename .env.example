# Copy to .env for local development. In production (Railway) set these as
# service variables instead; never commit a real .env.

FLASK_APP=run.py
FLASK_DEBUG=0
# Long random string, e.g. python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
DATABASE_URL=sqlite:///app.db
UPLOAD_FOLDER=/tmp/uploads

# Site owner: created as superadmin on first start; gets new-team alerts
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Email (optional) - see docs/EMAIL_SETUP.md
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=

# Proxies in front of the app (Railway: 1; 0 when reached directly)
PROXY_COUNT=1
