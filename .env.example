# Copy to .env for local development. In production (Railway) set these as
# service variables instead; never commit a real .env.

FLASK_APP=run.py
FLASK_DEBUG=0
# Login cookies are https-only; set to 0 to log in over plain http locally
SESSION_COOKIE_SECURE=1
# Long random string, e.g. python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
DATABASE_URL=sqlite:///app.db
UPLOAD_FOLDER=/tmp/uploads

# Site owner: created as superadmin on first start; gets new-team alerts
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Email (optional) - see docs/EMAIL_SETUP.md. Railway below Pro blocks SMTP:
# use BREVO_API_KEY (or RESEND_API_KEY) + MAIL_DEFAULT_SENDER instead.
BREVO_API_KEY=
RESEND_API_KEY=
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=

# Privacy policy (/privacy): who runs the site, the address for data
# requests (defaults to ADMIN_EMAIL), and how many days backups are kept
SITE_OPERATOR=
PRIVACY_CONTACT_EMAIL=
BACKUP_RETENTION_DAYS=30

# Error reports (optional): the DSN from a Sentry project
SENTRY_DSN=

# Proxies in front of the app (Railway: 1; 0 when reached directly)
PROXY_COUNT=1
